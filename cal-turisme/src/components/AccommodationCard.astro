---
import HillPanel from './HillPanel.astro';

interface Props {
  name: string;
  description: string;
  url: string;
  image?: string;
  date?: string;
}
const { name, description, url, image, date } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---
<article class="post">
  <div class="post-head">
    <span class="avatar" aria-hidden="true">{initial}</span>
    <span class="post-name">{name}</span>
  </div>

  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="post-image"
    aria-label={`Visita ${name} (s'obre en una altra pestanya)`}
  >
    {image ? <img src={image} alt={name} loading="lazy" /> : <HillPanel />}
  </a>

  <div class="post-caption">
    <p class="caption-text">
      <strong>{name}</strong> {description}
    </p>
    {date && <p class="post-date">{date}</p>}
    <a href={url} target="_blank" rel="noopener noreferrer" class="btn-link">
      Visita el seu lloc web
    </a>
  </div>
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.85rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-pine);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .post-name {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .post-image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .post-image:hover img { transform: scale(1.02); }

  .post-caption {
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .caption-text {
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .caption-text strong {
    font-weight: 600;
  }
  .post-date {
    font-size: 0.78rem;
    color: var(--color-pine-dark);
    opacity: 0.75;
  }
  .post-caption .btn-link {
    margin-top: 0.15rem;
    font-size: 0.88rem;
  }
</style>
