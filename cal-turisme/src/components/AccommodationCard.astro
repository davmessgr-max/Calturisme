---
import HillPanel from './HillPanel.astro';

interface Props {
  name: string;
  description: string;
  url: string;
  images?: string[];
  date?: string;
}
const { name, description, url, images = [], date } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
const hasImages = images.length > 0;
const isCarousel = images.length > 1;
---
<article class="post reveal">
  <div class="post-head">
    <span class="avatar" aria-hidden="true">{initial}</span>
    <span class="post-name">{name}</span>
  </div>

  <div class="post-image" data-carousel={isCarousel ? 'true' : undefined}>
    {hasImages ? (
      <div class="carousel-track">
        {images.map((src) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visita ${name} (s'obre en una altra pestanya)`}
          >
            <img src={src} alt={name} loading="lazy" />
          </a>
        ))}
      </div>
    ) : (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visita ${name} (s'obre en una altra pestanya)`}
      >
        <HillPanel />
      </a>
    )}

    {isCarousel && (
      <>
        <button class="car-btn prev" type="button" aria-label="Foto anterior">‹</button>
        <button class="car-btn next" type="button" aria-label="Foto seguent">›</button>
        <div class="dots">
          {images.map((_, i) => <span class="dot" data-index={i}></span>)}
        </div>
      </>
    )}
  </div>

  <div class="post-caption">
    <p class="caption-text">
      <strong>{name}</strong> {description}
    </p>
    {date && <p class="post-date">{date}</p>}
    <a href={url} target="_blank" rel="noopener noreferrer" class="btn-link">
      Visita el seu lloc web
    </a>
  </div>
</article>

<script>
  document.querySelectorAll('[data-carousel="true"]').forEach((car) => {
    const track = car.querySelector('.carousel-track');
    const dots = car.querySelectorAll('.dot');
    const prevBtn = car.querySelector('.prev');
    const nextBtn = car.querySelector('.next');
    if (!track) return;

    function update() {
      const idx = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    }
    track.addEventListener('scroll', () => window.requestAnimationFrame(update));
    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
    });
    update();
  });
</script>

<style>
  .post {
    display: flex;
    flex-direction: column;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.85rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-pine);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .post-name {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .post-image {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .post-image > a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track > a {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .car-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: none;
    background: rgba(243, 239, 228, 0.85);
    color: var(--color-ink);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .car-btn.prev { left: 0.6rem; }
  .car-btn.next { right: 0.6rem; }
  .car-btn:hover { background: var(--color-paper); }

  .dots {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgba(43, 42, 34, 0.35);
  }
  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgba(243, 239, 228, 0.6);
  }
  .dot.active { background: var(--color-paper); }

  .post-caption {
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .caption-text {
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .caption-text strong {
    font-weight: 600;
  }
  .post-date {
    font-size: 0.78rem;
    color: var(--color-pine-dark);
    opacity: 0.75;
  }
  .post-caption .btn-link {
    margin-top: 0.15rem;
    font-size: 0.88rem;
  }
</style>
