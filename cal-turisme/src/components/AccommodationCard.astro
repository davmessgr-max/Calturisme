---
import fs from 'node:fs';
import path from 'node:path';
import HillPanel from './HillPanel.astro';

type MediaItem =
  | string
  | { type: 'video'; src: string; poster?: string }
  | { type: 'instagram'; id: string };

interface Props {
  name: string;
  description: string;
  url: string;
  media?: MediaItem[];
  date?: string;
}
const { name, description, url, media = [], date } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();

// A video slide only appears once its file exists in /public, so the JSON can
// list it before the mp4 has been uploaded.
const roots = [process.cwd(), path.join(process.cwd(), 'cal-turisme')];
const fileExists = (src: string) => roots.some((r) => fs.existsSync(path.join(r, 'public', src)));
const items = media
  .filter((m) => typeof m === 'string' || m.type === 'instagram' || fileExists(m.src))
  .map((m) => (typeof m === 'string' ? { type: 'image' as const, src: m } : m));
const hasMedia = items.length > 0;
const isCarousel = items.length > 1;
const label = `Visita ${name} (s'obre en una altra pestanya)`;
---
<article class="post reveal">
  <div class="post-head">
    <span class="avatar" aria-hidden="true">{initial}</span>
    <span class="post-name">{name}</span>
  </div>

  <div class="post-image" data-carousel={isCarousel ? 'true' : undefined}>
    {hasMedia ? (
      <div class="carousel-track">
        {items.map((item) =>
          item.type === 'instagram' ? (
            <div class="slide slide--embed">
              <iframe
                src={`https://www.instagram.com/p/${item.id}/embed/`}
                title={`Publicació de ${name} a Instagram`}
                loading="lazy"
                scrolling="no"
                allowfullscreen
              ></iframe>
            </div>
          ) : item.type === 'video' ? (
            <div class="slide slide--video">
              <video
                src={item.src}
                poster={item.poster}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={`Vídeo de ${name}`}
              ></video>
              <button class="sound" type="button" aria-label="Activar el so" aria-pressed="false">
                <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m16 9 5 6M21 9l-5 6"/></svg>
                <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
              </button>
            </div>
          ) : (
            <a class="slide" href={url} target="_blank" rel="noopener noreferrer" aria-label={label}>
              <img src={item.src} alt={name} loading="lazy" />
            </a>
          )
        )}
      </div>
    ) : (
      <a class="slide" href={url} target="_blank" rel="noopener noreferrer" aria-label={label}>
        <HillPanel />
      </a>
    )}

    {isCarousel && (
      <>
        <button class="car-btn prev" type="button" aria-label="Anterior">‹</button>
        <button class="car-btn next" type="button" aria-label="Següent">›</button>
        <div class="dots">
          {items.map((_, i) => <span class="dot" data-index={i}></span>)}
        </div>
      </>
    )}
  </div>

  <div class="post-caption">
    <p class="caption-text">
      <strong>{name}</strong> {description}
    </p>
    {date && <p class="post-date">{date}</p>}
    <a href={url} target="_blank" rel="noopener noreferrer" class="btn-link">
      Visita el seu lloc web
    </a>
  </div>
</article>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.post-image').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.carousel-track');
    const slides = track ? Array.from(track.children) : [];
    const dots = box.querySelectorAll('.dot');
    const videos = box.querySelectorAll<HTMLVideoElement>('video');
    let visible = false;

    const activeIndex = () => (track ? Math.round(track.scrollLeft / track.clientWidth) : 0);

    const syncVideos = () => {
      const idx = activeIndex();
      videos.forEach((v) => {
        const slideIdx = track ? slides.indexOf(v.closest('.slide') as Element) : 0;
        if (visible && slideIdx === idx && !reduceMotion) v.play().catch(() => {});
        else v.pause();
      });
    };

    const update = () => {
      const idx = activeIndex();
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
      syncVideos();
    };

    if (track) {
      track.addEventListener('scroll', () => window.requestAnimationFrame(update));
      box.querySelector('.prev')?.addEventListener('click', () =>
        track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' })
      );
      box.querySelector('.next')?.addEventListener('click', () =>
        track.scrollBy({ left: track.clientWidth, behavior: 'smooth' })
      );
    }

    if (videos.length) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          syncVideos();
        },
        { threshold: 0.3 }
      ).observe(box);

      if (reduceMotion) videos.forEach((v) => (v.controls = true));

      box.querySelectorAll<HTMLButtonElement>('.sound').forEach((btn) => {
        btn.addEventListener('click', () => {
          const v = btn.parentElement?.querySelector('video');
          if (!v) return;
          v.muted = !v.muted;
          btn.setAttribute('aria-pressed', String(!v.muted));
          btn.classList.toggle('is-on', !v.muted);
        });
      });
    }

    update();
  });
</script>

<style>
  .post {
    display: flex;
    flex-direction: column;
  }

  .post-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.85rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-pine);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 0.95rem;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px var(--color-paper), 0 0 0 4px var(--color-clay);
  }
  .post-name {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .post-image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-kalamata);
  }
  .post-image > a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .post-image img,
  .post-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track > .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: block;
    position: relative;
  }

  .slide--embed { background: #fff; }
  .slide--embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .sound {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: none;
    background: rgba(20, 14, 10, 0.55);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .sound svg { width: 1.1rem; height: 1.1rem; }
  .sound .on { display: none; }
  .sound.is-on .on { display: block; }
  .sound.is-on .off { display: none; }

  .car-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: none;
    background: rgba(243, 239, 228, 0.85);
    color: var(--color-ink);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .car-btn.prev { left: 0.6rem; }
  .car-btn.next { right: 0.6rem; }
  .car-btn:hover { background: var(--color-paper); }

  .dots {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgba(43, 33, 24, 0.35);
  }
  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgba(243, 239, 228, 0.6);
  }
  .dot.active { background: var(--color-paper); }

  .post-caption {
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }
  .caption-text {
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .caption-text strong {
    font-weight: 600;
  }
  .post-date {
    font-size: 0.78rem;
    color: var(--color-pine-dark);
    opacity: 0.75;
  }
  .post-caption .btn-link {
    margin-top: 0.15rem;
    font-size: 0.88rem;
  }
</style>
