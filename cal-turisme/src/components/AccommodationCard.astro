---
import HillPanel from './HillPanel.astro';

interface Props {
  name: string;
  description: string;
  url: string;
  image?: string;
}
const { name, description, url, image } = Astro.props;
---
<article class="card">
  <a href={url} target="_blank" rel="noopener noreferrer" class="visual" aria-label={`Visita ${name} (s'obre en una altra pestanya)`}>
    {image ? <img src={image} alt="" loading="lazy" /> : <HillPanel />}
  </a>
  <div class="body">
    <h3><a href={url} target="_blank" rel="noopener noreferrer">{name}</a></h3>
    <p class="desc measure">{description}</p>
    <a href={url} target="_blank" rel="noopener noreferrer" class="btn-link">
      Visita el seu lloc web
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .visual {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .visual:hover img { transform: scale(1.03); }
  .body {
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a:hover { color: var(--color-clay); }
  .desc {
    font-size: 0.92rem;
    color: var(--color-ink);
    opacity: 0.85;
  }
</style>
