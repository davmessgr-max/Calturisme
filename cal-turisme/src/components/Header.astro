---
import Logo from './Logo.astro';
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Inici' },
  { href: '/qui-som/', label: 'Qui som' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark">
      <Logo size={26} />
      <span>Cal Turisme</span>
    </a>
    <nav aria-label="Navegacio principal">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={pathname === link.href ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <hr class="hairline" />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    transition: box-shadow 0.3s ease;
  }
  .site-header.is-scrolled {
    box-shadow: 0 8px 24px -18px rgba(43, 33, 24, 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.65rem;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }
  nav ul {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.95rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    border-color: var(--color-clay);
  }
</style>
