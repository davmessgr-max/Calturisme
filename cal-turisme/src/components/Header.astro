---
import Logo from './Logo.astro';
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Inici' },
  { href: '/qui-som/', label: 'Qui som' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark">
      <Logo size={26} />
      <span>Cal Turisme</span>
    </a>
    <nav aria-label="Navegacio principal">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={pathname === link.href ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: #fff;
    transition: background-color 0.4s ease, box-shadow 0.4s ease, color 0.4s ease;
  }
  .site-header.is-scrolled {
    background: rgba(247, 243, 236, 0.94);
    backdrop-filter: blur(10px);
    color: var(--color-ink);
    box-shadow: 0 8px 24px -18px rgba(43, 33, 24, 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    transition: padding 0.4s ease;
  }
  .is-scrolled .bar { padding-block: 0.6rem; }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .site-header:not(.is-scrolled) :global(svg g:first-of-type) { stroke: #D8AEBB; }
  .site-header:not(.is-scrolled) :global(svg g:last-of-type) { stroke: #F7F3EC; }
  nav ul {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    font-size: 0.95rem;
    font-weight: 500;
    padding-bottom: 0.2rem;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transition: right 0.35s ease;
  }
  nav a:hover::after,
  nav a[aria-current="page"]::after { right: 0; }
</style>
