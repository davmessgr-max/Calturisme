---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import allotjaments from '../data/allotjaments.json';
---
<BaseLayout title="Inici">
  <section class="hero">
    <div class="wrap">
      <p class="hero-line">Fes turisme on cal, fes-lo amb Cal Turisme.</p>
    </div>
  </section>

  <section class="listing">
    <div class="wrap">
      <div class="listing-head">
        <h2>Allotjaments</h2>
        <p class="measure">Un recull d'espais per allotjar-te, triats amb criteri.</p>
      </div>
      <hr class="hairline" />
      <div class="feed">
        {allotjaments.map((item) => <AccommodationCard {...item} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--color-paper-2);
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.5rem;
  }
  .hero-line {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 1vw, 1.5rem);
    text-align: center;
  }

  .listing { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .listing-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }
  .listing-head h2 { font-size: var(--step-2); }
  .listing-head p { opacity: 0.8; }

  .feed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2.5rem;
  }
  .feed > :global(*) {
    width: 100%;
    max-width: clamp(30rem, 42vw, 46rem);
  }
</style>
