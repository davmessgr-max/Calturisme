---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import HillPanel from '../components/HillPanel.astro';
import allotjaments from '../data/allotjaments.json';
---
<BaseLayout title="Inici">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">On cal fer turisme? A Cal Turisme.</p>
        <h1>El turisme rural, fet amb cura.</h1>
        <p class="lede measure">
          Cal Turisme reuneix petits allotjaments turistics -masies, cases
          rurals, ecofinques i albergs- compromesos amb el turisme
          sostenible. Ajudem a millorar la seva presencia digital i
          acompanyem qui vol descobrir el territori d'una altra manera.
        </p>
        <a href="/qui-som/" class="btn-link">Coneix el projecte</a>
      </div>
      <div class="hero-visual">
        <HillPanel />
      </div>
    </div>
  </section>

  <section class="listing">
    <div class="wrap">
      <div class="listing-head">
        <h2>Allotjaments</h2>
        <p class="measure">Un recull d'espais per allotjar-te, triats amb criteri.</p>
      </div>
      <hr class="hairline" />
      <div class="feed">
        {allotjaments.map((item) => <AccommodationCard {...item} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .kicker {
    font-size: 0.95rem;
    color: var(--color-pine-dark);
    margin-bottom: 0.9rem;
  }
  .hero-text h1 {
    font-size: var(--step-3);
    margin-bottom: 1.1rem;
  }
  .lede {
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }
  .hero-visual {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .listing { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .listing-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }
  .listing-head h2 { font-size: var(--step-2); }
  .listing-head p { opacity: 0.8; }

  .feed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2.5rem;
  }
  .feed > :global(*) {
    width: 100%;
    max-width: 30rem;
  }

  @media (max-width: 46rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; aspect-ratio: 16 / 9; }
  }
</style>
