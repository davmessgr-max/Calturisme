---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import HillPanel from '../components/HillPanel.astro';
import allotjaments from '../data/allotjaments.json';
---
<BaseLayout title="Inici">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text reveal">
        <p class="eyebrow">On cal fer turisme</p>
        <h1>El turisme rural, <em>fet amb cura</em>.</h1>
        <p class="lede measure">
          Cal Turisme reuneix petits allotjaments turístics —masies, cases
          rurals, ecofinques i albergs— compromesos amb el turisme
          sostenible. Ajudem a millorar la seva presència digital i
          acompanyem qui vol descobrir el territori d'una altra manera.
        </p>
        <div class="hero-actions">
          <a href="#allotjaments" class="btn btn--primary">Veure allotjaments</a>
          <a href="/qui-som/" class="btn btn--outline">Coneix el projecte</a>
        </div>
      </div>
      <div class="hero-visual reveal">
        <HillPanel />
      </div>
    </div>
  </section>

  <section class="section values">
    <div class="wrap">
      <div class="section-head center measure reveal">
        <p class="eyebrow center">El projecte</p>
        <h2>Turisme que fa bé al territori</h2>
        <p class="lede center">
          Ajudem petits allotjaments a fer-se visibles sense dependre de
          les grans plataformes, i acompanyem qui viatja a triar-los amb
          criteri.
        </p>
      </div>
      <div class="icon-cards reveal">
        <div class="icon-card">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2.5l2.3 2 2.9-.5.9 2.8 2.6 1.4-.9 2.8.9 2.8-2.6 1.4-.9 2.8-2.9-.5L12 21.5l-2.3-2-2.9.5-.9-2.8-2.6-1.4.9-2.8-.9-2.8 2.6-1.4.9-2.8 2.9.5L12 2.5z"/>
            <path d="M8.6 12.4l2.2 2.2 4.6-4.7"/>
          </svg>
          <h3>Triats amb criteri</h3>
          <p>Cada allotjament es revisa un per un: gestió pròpia, arrelament al territori i compromís amb la sostenibilitat.</p>
        </div>
        <div class="icon-card">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 21c8 0 14-6 14-14V5h-2C9 5 5 11 5 19v2z"/>
            <path d="M5 21c3-6 6-9 12-12"/>
          </svg>
          <h3>Turisme que hi encaixa</h3>
          <p>Fem costat a masies, cases rurals, ecofinques i albergs que fan créixer el territori, no que l'esgoten.</p>
        </div>
        <div class="icon-card">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="M3 7l9 6 9-6"/>
          </svg>
          <h3>Contacte directe</h3>
          <p>Reserves directament amb qui gestiona l'allotjament, sense intermediaris ni comissions amagades.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="listing" id="allotjaments">
    <div class="wrap">
      <div class="listing-head reveal">
        <h2>Allotjaments</h2>
        <p class="measure">Un recull d'espais per allotjar-te, triats amb criteri.</p>
      </div>
      <hr class="hairline" />
      <div class="feed">
        {allotjaments.map((item) => <AccommodationCard {...item} />)}
      </div>
    </div>
  </section>

  <section class="banner reveal">
    <div class="wrap center measure">
      <p class="eyebrow center">Ets un allotjament?</p>
      <h2>Gestiones un allotjament rural?</h2>
      <p class="lede center">
        Busquem espais amb caràcter propi i compromís real amb el
        territori per afegir al recull.
      </p>
      <a href="mailto:calturisme@gmail.com" class="btn btn--outline" style="margin-top: 1.5rem;">Escriu-nos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6.5rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-text h1 {
    font-size: var(--step-3);
    margin-bottom: 1.1rem;
  }
  .hero-text h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-pine-dark);
  }
  .hero-text .lede {
    font-size: 1.05rem;
    margin-bottom: 1.75rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero-visual {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .section-head { margin-bottom: 2.5rem; }
  .icon-cards { margin-top: 1rem; }

  .listing { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .listing-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }
  .listing-head h2 { font-size: var(--step-2); }
  .listing-head p { opacity: 0.8; }

  .feed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2.5rem;
  }
  .feed > :global(*) {
    width: 100%;
    max-width: clamp(30rem, 42vw, 46rem);
  }

  @media (max-width: 46rem) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; aspect-ratio: 16 / 9; }
  }
</style>
