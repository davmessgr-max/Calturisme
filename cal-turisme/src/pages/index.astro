---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import Logo from '../components/Logo.astro';
import IgIcon from '../components/IgIcon.astro';
import allotjaments from '../data/allotjaments.json';

const igUrl = 'https://www.instagram.com/calturisme/';
---
<BaseLayout title="Inici">
  <section class="hero hero--compact">
    <div class="hero__media">
      <img
        src="/img/hero-fachada.jpg"
        alt="Façana de pedra d'una masia entre cipressos i jardí"
        fetchpriority="high"
      />
    </div>
    <div class="wrap hero__content">
      <div class="hero-row">
        <div>
          <p class="eyebrow">On cal fer turisme</p>
          <h1>El turisme rural, <em>fet amb cura.</em></h1>
          <p class="hero__sub">Petits allotjaments compromesos amb el turisme sostenible.</p>
        </div>
        <div class="ig-pill">
          <div class="ig-avatar"><Logo size={18} /></div>
          <span class="ig-handle">@calturisme</span>
          <a href={igUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm ig-follow">
            <IgIcon /> Segueix-nos
          </a>
        </div>
      </div>
      <ul class="hero-chips" aria-label="Què ens defineix">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5l2.3 2 2.9-.5.9 2.8 2.6 1.4-.9 2.8.9 2.8-2.6 1.4-.9 2.8-2.9-.5L12 21.5l-2.3-2-2.9.5-.9-2.8-2.6-1.4.9-2.8-.9-2.8 2.6-1.4.9-2.8 2.9.5L12 2.5z"/><path d="M8.6 12.4l2.2 2.2 4.6-4.7"/></svg>
          Triats amb criteri
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21c8 0 14-6 14-14V5h-2C9 5 5 11 5 19v2z"/><path d="M5 21c3-6 6-9 12-12"/></svg>
          Turisme que hi encaixa
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          Contacte directe
        </li>
      </ul>
    </div>
  </section>

  <section class="listing" id="allotjaments">
    <div class="wrap">
      <div class="ig-tabs">
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Allotjaments
        </span>
      </div>
      <div class="feed">
        {allotjaments.map((item) => <AccommodationCard {...item} />)}
      </div>
    </div>
  </section>

  <section class="banner banner--photo reveal">
    <div class="banner__media">
      <img src="/img/porche-piscina.jpg" alt="" loading="lazy" />
    </div>
    <div class="wrap center measure">
      <p class="eyebrow center">Ets un allotjament?</p>
      <h2>Gestiones un allotjament rural?</h2>
      <p class="lede center">
        Busquem espais amb caràcter propi i compromís real amb el
        territori per afegir al recull.
      </p>
      <a href="mailto:calturisme@gmail.com" class="btn btn--outline" style="margin-top: 1.5rem;">Escriu-nos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .listing { padding-block: 0 clamp(3rem, 6vw, 4.5rem); }

  .feed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
  }
  .feed > :global(*) {
    width: 100%;
    max-width: min(clamp(30rem, 42vw, 46rem), 72vh);
    max-width: min(clamp(30rem, 42vw, 46rem), 72svh);
  }
</style>
