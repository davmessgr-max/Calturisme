---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Qui som">
  <section class="intro">
    <div class="wrap">
      <h1>Qui som</h1>
      <p class="lede measure">
        Cal Turisme és un projecte pensat per fer créixer el turisme
        sostenible al territori, connectant qui viatja amb petits
        allotjaments que fan les coses bé.
      </p>
    </div>
  </section>

  <section class="vies">
    <div class="wrap grid">
      <div class="via">
        <h2>Acompanyem els allotjaments</h2>
        <p class="measure">
          Ajudem hotels, cases rurals, ecofinques, albergs i masies
          històriques a millorar la seva presència digital, perquè
          arribin a més gent sense dependre només de grans plataformes.
        </p>
      </div>
      <div class="via">
        <h2>Acompanyem qui viatja</h2>
        <p class="measure">
          Reunim en un sol lloc allotjaments que aposten pel territori i
          la sostenibilitat, perquè triar on allotjar-se sigui més
          senzill i més conscient.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
  .intro h1 { font-size: var(--step-3); margin-bottom: 1.1rem; }
  .intro .lede { font-size: 1.05rem; }

  .vies { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  .via {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .via h2 { font-size: var(--step-1); margin-bottom: 0.75rem; color: var(--color-pine-dark); }
</style>
